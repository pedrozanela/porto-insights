# Porto Insights — variáveis de ambiente (dev local e app.yaml).
# Copie para .env em dev local. Nenhum segredo aqui: a auth é OBO (token do usuário) em prod,
# e o profile do CLI em dev local. NÃO commitar .env.

# --- Workspace ---
DATABRICKS_HOST=fevm-pzanela-classic-aws.cloud.databricks.com
# Dev local: profile do CLI usado quando não há header x-forwarded-access-token.
DATABRICKS_CONFIG_PROFILE=fevm-pzanela-classic-aws

# --- Dados (Fase 0) ---
PORTO_CATALOG=pzanela_classic_aws_catalog
PORTO_SCHEMA=porto_insights
SQL_WAREHOUSE_ID=848374d85d2bad86

# --- Modelos (Fase 0) ---
MODEL_ENDPOINTS=databricks-claude-sonnet-5:Claude Sonnet 5,databricks-claude-opus-5:Claude Opus 5,databricks-gpt-5-5:GPT-5.5,databricks-gemini-3-8-flash:Gemini 3.8 Flash,databricks-llama-4-maverick:Llama 4 Maverick
DEFAULT_MODEL_ENDPOINT=databricks-claude-sonnet-5

# --- Genie One MCP ---
GENIE_MCP_URL=https://${DATABRICKS_HOST}/api/2.0/mcp/genie
GENIE_POLL_INITIAL_MS=1500
GENIE_POLL_MAX_MS=5000
GENIE_MAX_WAIT_S=260
GENIE_MAX_ROWS_TO_LLM=50
# Genie Agent de suporte (informativo; o app não o chama diretamente).
CREATE_SUPPORT_GENIE_AGENT=true

# --- MCP Services Google (built-in; não criar connections) ---
MCP_GOOGLE_SERVICES=system.ai.gmail,system.ai.google_calendar,system.ai.google_drive
MCP_TOOL_ALLOWLIST_EXTRA=
MCP_TOOL_DENYLIST_EXTRA=

# --- Web search MCP Service (system.ai.web_search) ---
# Busca pública com citações via AI Gateway (mesmo caminho OBO; escopo ai-gateway já cobre).
# Única fonte EXTERNA; não alimenta o grafo. true para habilitar.
MCP_WEB_SEARCH_ENABLED=false

# --- Agente / grafo ---
AGENT_MAX_TOOL_ITERATIONS=8
SEMANTIC_LINKER_MIN_CONFIDENCE=0.6
TIME_WINDOW_DAYS=3

# --- Observabilidade (opcional) ---
MLFLOW_EXPERIMENT_PATH=
LOG_LEVEL=INFO
